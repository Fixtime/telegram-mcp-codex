{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/mcpb/main/dist/mcpb-manifest.schema.json",
  "manifest_version": "0.4",
  "name": "telegram-analysis",
  "display_name": "Telegram Analysis",
  "version": "1.0.0",
  "description": "Read-only Telegram chats, groups and channels for Codex. Five bounded tools.",
  "author": {
    "name": "Fixtime"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fixtime/telegram-mcp-codex"
  },
  "homepage": "https://github.com/Fixtime/telegram-mcp-codex",
  "documentation": "https://github.com/Fixtime/telegram-mcp-codex#readme",
  "server": {
    "type": "uv",
    "entry_point": "telegram_analysis_mcp.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with-requirements",
        "${__dirname}/requirements-analysis.lock",
        "${__dirname}/telegram_analysis_mcp.py",
        "--config",
        "${user_config.config_path}"
      ]
    }
  },
  "user_config": {
    "config_path": {
      "type": "string",
      "title": "Private configuration path",
      "required": true,
      "description": "Absolute path to config.json created by local terminal setup. Do not paste credentials here."
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.11"
    }
  },
  "keywords": [
    "telegram",
    "read-only",
    "analysis",
    "codex"
  ],
  "license": "Apache-2.0"
}
